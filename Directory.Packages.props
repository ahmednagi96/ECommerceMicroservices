<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Let us pin vulnerable transitive packages from here -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- One variable per framework-bound family: upgrade = edit one line -->
    <EfCoreVersion>10.0.14</EfCoreVersion>
    <AspNetCoreVersion>10.0.14</AspNetCoreVersion>
  </PropertyGroup>
  <ItemGroup Label="Framework-bound">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.1" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Label="Third-party">
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
  </ItemGroup>
  <ItemGroup Label="Security pins (transitive)">
    <!-- EF Core SqlServer -> Microsoft.Data.SqlClient 6.1.7 -> Pkcs 9.0.11
         (GHSA-846f-f764-76mx, high). Remove once SqlClient ships a fixed one. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!--health check -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <!--  <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" /> -->
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="6.61.0" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.61.0" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.61.0" />
    <PackageVersion Include="WolverineFx.SqlServer" Version="6.61.0" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>
</Project>