{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "CorsPolicy": "frontend",
        "Match": { "Path": "/catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/catalog" } ]
      },
      "basket-route": {
        "ClusterId": "basket-cluster",
        "AuthorizationPolicy": "default",
        "CorsPolicy": "frontend",
        "Match": { "Path": "/basket/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/basket" } ]
      },
      "ordering-route": {
        "ClusterId": "ordering-cluster",
        "AuthorizationPolicy": "default",  
        "CorsPolicy": "frontend",
        "Match": { "Path": "/ordering/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/ordering" } ]
      },
      "checkout-route": {
      "ClusterId": "basket-cluster",
      "AuthorizationPolicy": "default",  
      "CorsPolicy": "frontend",
      "RateLimiterPolicy": "checkout",
      "Match": {
        "Path": "/basket/api/basket/checkout",
        "Methods": [ "POST" ]
      },
      "Transforms": [ { "PathRemovePrefix": "/basket" } ]
      },
    "bff-route": {
      "ClusterId": "bff-cluster",
      "AuthorizationPolicy": "default",  
      "CorsPolicy": "frontend",
      "Match": { "Path": "/bff/{**catch-all}" },
      "Transforms": [ { "PathRemovePrefix": "/bff" } ]
    }
  },

    "Clusters": {
      "catalog-cluster": {
      "LoadBalancingPolicy": "RoundRobin",
      "HttpRequest": {
    "ActivityTimeout": "00:00:10"
  },
      "HealthCheck": {
        "Active": {
          "Enabled": true,
          "Interval": "00:00:10",
          "Timeout": "00:00:05",
          "Policy": "ConsecutiveFailures",
          "Path": "/health/ready"
        }
      }
    },
      "basket-cluster": {
      "LoadBalancingPolicy": "RoundRobin",
      "HttpRequest": {
    "ActivityTimeout": "00:00:35"
  },
      "HealthCheck": {
        "Active": {
          "Enabled": true,
          "Interval": "00:00:10",
          "Timeout": "00:00:05",
          "Policy": "ConsecutiveFailures",
          "Path": "/health/ready"
        }
      }
    },
     "ordering-cluster": {
      "LoadBalancingPolicy": "RoundRobin",
      "HttpRequest": {
    "ActivityTimeout": "00:00:05"
  },
      "HealthCheck": {
        "Active": {
          "Enabled": true,
          "Interval": "00:00:10",
          "Timeout": "00:00:05",
          "Policy": "ConsecutiveFailures",
          "Path": "/health/ready"
        }
      }
    },
    "bff-cluster": {
  "HttpRequest": {
    "ActivityTimeout": "00:00:15"
  },
  "HealthCheck": {
    "Active": {
      "Enabled": true,
      "Interval": "00:00:10",
      "Timeout": "00:00:05",
      "Policy": "ConsecutiveFailures",
      "Path": "/health/live"
    }
  }
    }
  }
},

  "Cors": {
      "AllowedOrigins": [ "http://localhost:3000" ]
  },
    "Auth": {
  "MetadataAddress": "http://localhost:8180/realms/ecommerce/.well-known/openid-configuration",
  "Audience": "ecommerce-api"
  }
}
